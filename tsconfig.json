{
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@an-dr/commits-core/*": ["packages/core/src/*"],
      "@commits/adapter/*": ["apps/commits/bones-adapter/src/*"],
      "@commits/ipc/*": ["ipc/ts/*"],
      "@an-dr/commits-webview-shell/assets/*": ["packages/webview-shell/assets/*"],
      "@an-dr/commits-webview-shell/*": ["packages/webview-shell/src/*"]
    },
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/commits/bones-adapter/**/*.ts",
    "packages/core/src/webview/**/*.d.ts",
    "packages/webview-shell/**/*.ts",
    "ipc/**/*.ts",
    "ui/**/*.ts"
  ]
}
