{
  "name": "commits",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A standalone Git client on the bones engine",
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:wasm && npm run build:host",
    "build:bundle": "esbuild apps/commits/web/src/main.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/ui/page.js",
    "build:host": "cargo build --release -p commits-app",
    "build:page": "node apps/commits/scripts/generate-page.mjs",
    "build:wasm": "node apps/commits/scripts/build-components.mjs",
    "build:web": "npm run check:ui-theme && npm run generate:tabler-icons && npm run build:bundle && npm run build:page",
    "check": "tsc --noEmit",
    "check:settings-compat": "node apps/commits/scripts/check-settings-compat.mjs",
    "check:ui-theme": "node apps/commits/scripts/check-ui-theme.mjs",
    "clean": "node scripts/clean.mjs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1",
    "dist:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1 -Part host",
    "dist:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1 -Part wasm",
    "dist:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1 -Part web",
    "generate:tabler-icons": "node apps/commits/scripts/generate-tabler-icons.mjs",
    "install:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "postinstall": "node scripts/patch-wizer-package.mjs",
    "test": "vitest run",
    "verify": "npm run build && npm run check && npm test && cargo test --workspace"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.19.3",
    "@bytecodealliance/jco": "1.17.9",
    "@commits/wizer-win32-arm64": "file:tooling/wizer-win32-arm64",
    "@tabler/icons-webfont": "^3.46.0",
    "@types/node": "24.1.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
